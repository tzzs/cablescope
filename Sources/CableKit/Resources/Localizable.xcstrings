{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "@ %@Hz" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "@ %@Hz"
          }
        }
      }
    },
    "e-marker 未上报厂商 ID（常见现象，非线缆质量判断依据）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e-marker did not report a vendor ID (common, not an indicator of cable quality)"
          }
        }
      }
    },
    "e-marker 未提供厂商身份信息，无法核对厂商" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "e-marker did not provide vendor identity information, so the vendor can't be verified"
          }
        }
      }
    },
    "EPR 线缆" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPR cable"
          }
        }
      }
    },
    "PD 合同 %@W 低于适配器可用档 %@W" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PD contract %@W is below the adapter's available %@W tier"
          }
        }
      }
    },
    "USB4/雷雳可用" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB4 / Thunderbolt available"
          }
        }
      }
    },
    "主动线缆" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active cable"
          }
        }
      }
    },
    "充电器正按合同满档输出" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Charger is outputting at its full contracted tier"
          }
        }
      }
    },
    "厂商 ID 不在已知厂商列表中" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vendor ID is not in the known vendor list"
          }
        }
      }
    },
    "常见于优化充电暂停或电池保温（电量接近充满时系统主动放缓）" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Common with Optimized Battery Charging or battery conditioning (the system slows down on purpose when nearly full)"
          }
        }
      }
    },
    "已接通电源，未在充电" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connected, not charging"
          }
        }
      }
    },
    "实际抽取 %@W，低于合同 %@W" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drawing %@W, below the %@W contract"
          }
        }
      }
    },
    "当前 %@W ≈ PD 合同 %@W" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now %@W ≈ PD contract %@W"
          }
        }
      }
    },
    "未接通电源，使用电池" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not connected, running on battery"
